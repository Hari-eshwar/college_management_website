rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Face dataset images — admin service account only
    match /faces/{student_id}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == 'admin';
      allow delete: if request.auth != null && request.auth.uid == 'admin';
    }

    // Attendance snapshots — admin only
    match /snapshots/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == 'admin';
    }

    // Public read for student profile images (optional)
    match /profiles/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'admin';
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
